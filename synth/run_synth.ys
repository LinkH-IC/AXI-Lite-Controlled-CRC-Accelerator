# Read SystemVerilog
read_verilog -sv ../rtl/*.v

# Set top module
hierarchy -check -top axi_crc_top

# Define clock (100 MHz example)
# create_clock -period 10 ACLK

# Generic synthesis
synth -top axi_crc_top

# Optimize
proc; opt;
fsm; opt;
memory; opt;

# DFF Mapping
dfflibmap -liberty ./lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# Logic Mapping
abc -liberty ./lib/sky130_fd_sc_hd__tt_025C_1v80.lib #-constr constraints.abc -D 400

opt_clean -purge

# Print Time Analysis
ltp

# Print Status
stat

# Write netlist
write_verilog top_synth.v
